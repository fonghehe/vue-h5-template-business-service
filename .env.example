# Copy to .env in the project root; go run ./cmd/server loads it automatically.
# Existing process variables take precedence. Other settings use the defaults
# listed in docs/configuration.md.

APP_ENV=development
PORT=8002

# Dedicated PostgreSQL database; POSTGRES_PORT is for Compose interpolation.
POSTGRES_PORT=5433
DATABASE_URL=postgres://vue_h5:vue_h5_local@127.0.0.1:5433/vue_h5_business?sslmode=disable

# Development placeholders: replace both secrets in production.
# JWT_SECRET must match the AI service.
JWT_SECRET=dev-only-change-me-before-production
MOCK_PAYMENT_WEBHOOK_SECRET=dev-mock-payment-webhook-secret-change-me
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional product cache. Empty disables Redis for native development.
REDIS_URL=

# Optional operational tuning; staging/production default AUTO_MIGRATE and SEED
# to false. Run make migrate before starting those environments.
# AUTO_MIGRATE=true
# SEED=true
# DB_MAX_OPEN_CONNS=25
# DB_MAX_IDLE_CONNS=5
# DB_CONN_MAX_LIFETIME=30m
# DB_CONN_MAX_IDLE_TIME=5m
# REQUEST_TIMEOUT=10s
# WRITE_TIMEOUT=30s
# READ_TIMEOUT=15s
# IDLE_TIMEOUT=60s
# SHUTDOWN_TIMEOUT=15s
