# ---------------------------------------------------------------------------
# vue-h5-template-business-service configuration
#
# Every value below is read from the environment. Copy this file to `.env` and
# adjust it. In production, replace every secret and switch to explicit CORS
# origins, JSON logs and a Secure refresh cookie.
# ---------------------------------------------------------------------------

# Service identity -----------------------------------------------------------
# One of: development | test | production
APP_ENV=development
PORT=8002
# One of: debug | info | warn | error
LOG_LEVEL=info
# One of: text | json (json is required in production)
LOG_FORMAT=text

# Database -------------------------------------------------------------------
# One of: postgres | sqlite (sqlite is for isolated demos/tests only)
DATABASE_DRIVER=postgres
DATABASE_URL=postgres://vue_h5:vue_h5_local@localhost:5432/vue_h5_business?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
AUTO_MIGRATE=true
SEED=true

# Authentication (JWT) -------------------------------------------------------
# Must match the AI service so access tokens minted here validate there.
JWT_SECRET=dev-only-change-me-before-production
JWT_ISSUER=vue-h5-template
JWT_AUDIENCE=vue-h5-template-api
ACCESS_TOKEN_TTL=2h
REFRESH_TOKEN_TTL=336h
REFRESH_COOKIE_NAME=vh5_refresh
# Must be true in production (HTTPS-only cookie).
REFRESH_COOKIE_SECURE=false

# CORS -----------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate limiting --------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40

# HTTP server timeouts -------------------------------------------------------
SHUTDOWN_TIMEOUT=15s
READ_TIMEOUT=15s
WRITE_TIMEOUT=30s
IDLE_TIMEOUT=60s
